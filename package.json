{
  "name": "s-base",
  "private": true,
  "workspaces": ["backend", "frontend"],
  "scripts": {
    "dev": "concurrently \"bun run dev:backend\" \"bun run dev:frontend\"",
    "dev:backend": "bun run --cwd backend dev",
    "dev:frontend": "bun run --cwd frontend dev",
    "test": "bun run --cwd backend test && bun run --cwd frontend test",
    "test:all": "bun run --cwd backend test && bun run --cwd frontend test && bun run --cwd frontend lint",
    "pre-push": "bun run test:all && bun run build",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "build": "bun run --cwd frontend build",
    "start": "concurrently \"bun run start:backend\" \"bun run start:frontend\"",
    "start:backend": "bun run --cwd backend start",
    "start:frontend": "bun run --cwd frontend start",
    "db:migrate": "bun run --cwd backend db:migrate",
    "db:seed": "bun run --cwd backend db:seed",
    "db:user": "bun run --cwd backend db:user"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
