      "id": "get-tree",
      "name": "Get Tree",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1820,
        100
      ],
      "credentials": {
        "githubApi": {
          "id": "",
          "name": "GitHub Minor Site"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const tree = $('Get Tree').first().json.tree || [];\nconst existing = new Set(tree.filter((t) => t.path.startsWith('public/minor/')).map((t) => t.path));\nconst needed = $('Validate Snapshot').first().json.assetFiles;\nconst missing = needed.filter((f) => !existing.has('public/minor/' + f));\nif (!missing.length) return [{ json: { file: null } }];\nreturn missing.map((file) => ({ json: { file } }));"
      },
      "id": "plan-assets",
      "name": "Plan Assets",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2080,
        100
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "has-file",
              "leftValue": "={{ $json.file }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "has-missing-assets",
      "name": "Has Missing Assets",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2340,
