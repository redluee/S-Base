    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.github.com/repos/redluee/future-proof-met-ai/git/blobs",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendHeaders": true,
        "headerParameters": {
