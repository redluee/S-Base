    {
      "parameters": {
        "method": "GET",
        "url": "http://172.17.0.1:3001/api/minor/public/snapshot",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      },
      "id": "fetch-snapshot",
      "name": "Fetch Snapshot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        100
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "SBase Snapshot"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const snap = $input.first().json;\nif (snap.version !== 1 || !snap.contentHash || !Array.isArray(snap.sprints) || !Array.isArray(snap.assets)) {\n  throw new Error('Invalid snapshot envelope');\n}\nfor (const s of snap.sprints) {\n  if (!Array.isArray(s.stories) || !Array.isArray(s.selfEvaluations)) throw new Error('Invalid sprint in snapshot');\n}\nif (/fromWhom|peerName/.test(JSON.stringify(snap))) throw new Error('Snapshot contains person names');\nreturn [{ json: { snapshot: snap, contentHash: snap.contentHash, assetFiles: snap.assets.map((a) => a.path.replace('public/minor/', '')) } }];"
      },
      "id": "validate-snapshot",
      "name": "Validate Snapshot",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        100
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/redluee/future-proof-met-ai/contents/data/minor-snapshot.json?ref=main",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        },
        "options": {}
      },
      "id": "get-repo-snapshot",
      "name": "Get Repo Snapshot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        100
      ],
      "credentials": {
        "githubApi": {
          "id": "",
          "name": "GitHub Minor Site"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const current = $('Validate Snapshot').first().json.contentHash;\nconst repo = $input.first().json;\nlet previous = '';\nif (repo.content) {\n  try { previous = JSON.parse(Buffer.from(repo.content, 'base64').toString('utf8')).contentHash || ''; } catch (e) {}\n}\nif (previous === current) return [];\nreturn [{ json: {} }];"
      },
      "id": "changed",
      "name": "Changed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        100
      ]
    },
