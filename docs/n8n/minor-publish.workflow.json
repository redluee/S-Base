    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/redluee/future-proof-met-ai/git/trees/{{ $json.tree.sha }}?recursive=1",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "githubApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
