      "id": "create-asset-blob",
      "name": "Create Asset Blob",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3120,
        0
      ],
      "credentials": {
        "githubApi": {
          "id": "",
          "name": "GitHub Minor Site"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const validate = $('Validate Snapshot').first().json;\nconst headSha = $('Get Main Ref').first().json.object.sha;\nconst baseTree = $('Get Commit').first().json.tree.sha;\nconst existing = ($('Get Tree').first().json.tree || []).filter((t) => t.type === 'blob' && t.path.startsWith('public/minor/') && !t.path.endsWith('.gitkeep'));\nconst entries = [{ path: 'data/minor-snapshot.json', mode: '100644', type: 'blob', content: JSON.stringify(validate.snapshot, null, 2) + '\\n' }];\nconst uploaded = $input.all().filter((i) => i.json.sha);\nconst files = uploaded.length ? $('To Base64').all() : [];\nuploaded.forEach((item, i) => entries.push({ path: 'public/minor/' + files[i].json.file, mode: '100644', type: 'blob', sha: item.json.sha }));\nconst keep = new Set(validate.assetFiles.map((f) => 'public/minor/' + f));\nfor (const t of existing) if (!keep.has(t.path)) entries.push({ path: t.path, mode: '100644', type: 'blob', sha: null });\nreturn [{ json: { headSha, baseTree, tree: entries, message: 'chore(minor): sync snapshot ' + validate.contentHash.slice(0, 7) } }];"
      },
