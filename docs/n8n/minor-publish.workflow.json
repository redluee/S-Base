      "id": "fetch-asset",
      "name": "Fetch Asset",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2600,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "SBase Snapshot"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const out = [];\nconst files = $('Plan Assets').all();\nfor (let i = 0; i < items.length; i++) {\n  const buf = await this.helpers.getBinaryDataBuffer(i, 'data');\n  out.push({ json: { file: files[i].json.file, content: buf.toString('base64') } });\n}\nreturn out;"
      },
      "id": "to-base64",
      "name": "To Base64",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
