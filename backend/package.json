{
  "name": "s-base-backend",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "test": "DB_PATH=:memory: bun test",
    "start": "NODE_ENV=production bun run src/index.ts",
    "bot": "bun run src/modules/minecraft/bot-runner.ts",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:seed": "bun run src/db/seed.ts",
    "db:user": "bun run src/db/user-manager.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.2.0",
    "discord.js": "^14.27.0",
    "drizzle-orm": "^0.40.1",
    "elysia": "^1.2.25"
  },
  "devDependencies": {
    "bun-types": "latest",
    "drizzle-kit": "^0.30.6"
  }
}
