{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": false
  },
  "files": {
    "includes": [
      "src/**",
      "!src/**/fixtures/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "warn",
        "noGlobalIsNan": "warn",
        "noControlCharactersInRegex": "warn",
        "noImplicitAnyLet": "warn",
        "noAssignInExpressions": "warn",
        "useIterableCallbackReturn": "warn",
        "noUselessEscapeInString": "warn"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useNodejsImportProtocol": "off",
        "useTemplate": "off",
        "useConst": "warn",
        "useImportType": "warn"
      },
      "complexity": {
        "useOptionalChain": "warn",
        "useLiteralKeys": "off",
        "useMathMinMax": "off",
        "noUselessEscapeInRegex": "warn",
        "noUselessUndefinedInitialization": "warn"
      },
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedFunctionParameters": "warn",
        "noUnsafeOptionalChaining": "warn"
      }
    }
  },
  "assist": {
    "enabled": false
  }
}
