# S-Base Environment Configuration

# ==========================================
# Minecraft (Lobby Control) Module Settings
# ==========================================
# Base directory where Minecraft server instances are stored.
# If not set, defaults to ~/minecraft/servers
MC_SERVERS_DIR=/home/stevo/minecraft/servers

# Directory where server templates are stored.
# If not set, defaults to the parent directory of MC_SERVERS_DIR + /templates
# MC_TEMPLATES_DIR=/home/stevo/minecraft/templates

# ==========================================
# Database & Core Backend Settings
# ==========================================
# Path to the SQLite database file
# DB_PATH=./sbase.db

# Backend server port
# PORT=3001

# Node Environment ('development' or 'production')
# NODE_ENV=development

# ==========================================
# Frontend API & Gateway Settings
# ==========================================
# Internal API URL for Next.js Server Components to fetch from Elysia backend
# API_URL=http://127.0.0.1:3001/api

# Optional custom WebSocket host for live console (defaults to localhost:3001 in dev)
# NEXT_PUBLIC_WS_HOST=localhost:3001
