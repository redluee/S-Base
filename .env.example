# S-Base Environment Configuration

# ==========================================
# Minecraft (Lobby Control) Module Settings
# ==========================================
# Base directory where Minecraft server instances are stored.
# If not set, defaults to ~/minecraft/servers
MC_SERVERS_DIR=/home/stevo/minecraft/servers

# Directory where server templates are stored.
# If not set, defaults to the parent directory of MC_SERVERS_DIR + /templates
# MC_TEMPLATES_DIR=/home/stevo/minecraft/templates

# ==========================================
# Database & Core Backend Settings
# ==========================================
# Path to the SQLite database file
# DB_PATH=./sbase.db

# Backend server port
# PORT=3001

# Node Environment ('development' or 'production')
# NODE_ENV=development

# ==========================================
# Frontend API & Gateway Settings
# ==========================================
# Internal API URL for Next.js Server Components to fetch from Elysia backend
# API_URL=http://127.0.0.1:3001/api

# Optional custom WebSocket host for live console (defaults to localhost:3001 in dev)
# NEXT_PUBLIC_WS_HOST=localhost:3001

# ==========================================
# Discord Bot Settings
# ==========================================
# Bot token from Discord Developer Portal
# DISCORD_BOT_TOKEN=your_bot_token_here
# Default Minecraft server slug for bot commands (/status, /start)
# DISCORD_BOT_DEFAULT_SERVER=hangout

# ==========================================
# Cashflow: SMTP (invoice e-mailing)
# ==========================================
# SMTP server used to send invoices by e-mail from the Cashflow module
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password
# Sender address (defaults to SMTP_USER if not set)
# SMTP_FROM=facturen@example.com

# ==========================================
# Minor: publishing to minor.stevenheijn.nl (via n8n)
# ==========================================
# Bearer token n8n uses to read /api/minor/public/* (generate with: openssl rand -hex 32)
# MINOR_SNAPSHOT_TOKEN=
# S-Base username whose minor data is published
# MINOR_PUBLISH_USERNAME=
# n8n production webhook called after self-evaluations are saved
# N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/minor-publish
# Shared secret sent as X-Webhook-Secret to n8n
# N8N_WEBHOOK_SECRET=

# ==========================================
# Production Security & Operations
# ==========================================
# REQUIRED in production, set for BOTH backend and Next.js server (used by /api/auth/cf-login).
# Generate with: openssl rand -hex 32
# INTERNAL_AUTH_SECRET=
# Comma-separated origins allowed for cross-origin API requests (empty = same-origin only in production)
# ALLOWED_ORIGINS=https://base.example.com
# Backend bind address (127.0.0.1 in production, 0.0.0.0 otherwise)
# HOST=127.0.0.1
# Daily SQLite backups in production (VACUUM INTO); defaults to <db dir>/backups, 14 kept
# BACKUP_DIR=/var/backups/sbase
# BACKUP_KEEP=14
# Backend refuses to start in production while admin/admin or tester/tester still work
# ALLOW_DEFAULT_USERS=1
